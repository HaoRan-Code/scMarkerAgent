{
  "schema_version": "scmarkeragent-transport-request-v1",
  "type": "object",
  "required": [
    "schema_version",
    "prompt",
    "reasoning_effort"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "scmarkeragent-transport-request-v1"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    }
  }
}
