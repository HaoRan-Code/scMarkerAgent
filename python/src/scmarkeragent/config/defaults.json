      "logfc_threshold": 0.1
    }
  },
  "retrieval": {
    "top_candidates": 45,
    "extra_context_top_candidates": 5,
    "corroboration_only": true,
    "min_eligible_genes": 2,
    "min_significant_hits": 3,
    "min_pool_floor": 8,
    "epsilon": 1e-09,
    "rank_quantization_decimals": 10
