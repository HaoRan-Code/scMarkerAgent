  "features": {
    "cross_species_markers": false,
    "cross_species_borrow": true,
    "exclude_in_vitro": true,
    "compute_umap": true,
    "cluster_annotation": true
  },
  "eligibility": {
    "tissue_root": "self",
    "min_corroborating_publications": 3,
    "corroborating_tiers": [
      "high"
    ]
  },
  "preprocessing": {
    "qc_min_genes": 200,
    "qc_min_cells": 3,
    "qc_max_mt_percent": 20.0,
